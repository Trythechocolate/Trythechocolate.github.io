{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":""},{"location":"#try-the-chocolate","title":"TRY THE CHOCOLATE","text":"<p>\u4e00\u5757\u5de7\u514b\u529b\uff0c\u6162\u6162\u54c1\uff0c\u624d\u6709\u5473\u9053\u3002</p> <p>\u4f60\u597d\u5440\uff0c\u6b22\u8fce\u6765\u5230\u6211\u7684\u5c0f\u7ad9\u3002</p> <p>\u8fd9\u91cc\u6536\u96c6\u4e86\u6211\u7684\u5b66\u4e60\u7b14\u8bb0\u3001\u8bfb\u4e66\u5fc3\u5f97\u548c\u751f\u6d3b\u968f\u60f3\uff0c\u50cf\u4e00\u5757\u624b\u5de5\u5de7\u514b\u529b\uff1a \u6bcf\u4e00\u7bc7\u90fd\u7528\u5fc3\u5236\u4f5c\uff0c\u5e0c\u671b\u4f60\u559c\u6b22\u3002</p>"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>TRY THE CHOCOLATE</p>"},{"location":"about/#_2","title":"\u6211\u662f\u8c01","text":"<p>\u4f60\u597d\uff0c\u6b22\u8fce\u6765\u5230\u6211\u7684\u5c0f\u7ad9\uff01</p> <p>\u6211\u662f\u4e00\u4e2a\u70ed\u7231\u5b66\u4e60\u4e0e\u8bb0\u5f55\u7684\u4eba\uff0c\u5bf9\u4f1a\u8ba1\u4e0e\u8d22\u52a1\u3001\u8ba1\u7b97\u673a\u3001\u7ecf\u6d4e\u5b66\u3001\u89c2\u9e1f\u3001\u8bfb\u4e66\u548c\u65c5\u884c\u90fd\u5145\u6ee1\u597d\u5947\u3002 \u8fd9\u91cc\u662f\u6211\u5206\u4eab\u77e5\u8bc6\u3001\u6c89\u6dc0\u601d\u8003\u7684\u5c0f\u5929\u5730\u3002</p>"},{"location":"about/#_3","title":"\u5173\u4e8e\u672c\u7ad9","text":"<p>TRY THE CHOCOLATE \u8fd9\u4e2a\u540d\u5b57\uff0c\u6e90\u4e8e\u4e00\u53e5\u8bdd\uff1a</p> <p>\u4e00\u5757\u5de7\u514b\u529b\uff0c\u6162\u6162\u54c1\uff0c\u624d\u6709\u5473\u9053\u3002</p> <p>\u613f\u8fd9\u91cc\u7684\u6bcf\u4e00\u7bc7\u6587\u7ae0\uff0c\u90fd\u50cf\u4e00\u5757\u503c\u5f97\u7ec6\u54c1\u7684\u5de7\u514b\u529b\u3002</p> <ul> <li>\u7b14\u8bb0\uff1a\u6280\u672f\u3001\u5b66\u79d1\u5b66\u4e60\u8bb0\u5f55</li> <li>\u8bfb\u4e66\uff1a\u4e66\u7c4d\u6458\u6284\u4e0e\u8bfb\u540e\u611f</li> <li>\u751f\u6d3b\uff1a\u65c5\u884c\u6e38\u8bb0\u4e0e\u65e5\u5e38\u968f\u7b14</li> </ul> <p>\u672c\u7ad9\u4f7f\u7528 MkDocs \u4e0e Material for MkDocs \u6784\u5efa\u3002</p>"},{"location":"about/#_4","title":"\u8054\u7cfb\u6211","text":"<ul> <li>\u6b22\u8fce\u4ea4\u6d41\uff0c\u53ef\u4ee5\u901a\u8fc7\u7559\u8a00\u6216\u90ae\u4ef6\u8054\u7cfb\u6211\uff08\u90ae\u7bb1\u5f85\u8865\u5145\uff09</li> </ul>"},{"location":"book/","title":"\u8bfb\u4e66","text":"<p>\u811a\u6b65\u4e08\u91cf\u4e0d\u5230\u7684\u5730\u65b9\uff0c\u6587\u5b57\u53ef\u4ee5\u3002</p> <p>\u8fd9\u91cc\u662f\u8bfb\u4e66\u7b14\u8bb0\u7684\u603b\u6c47\uff0c\u8bb0\u5f55\u8bfb\u8fc7\u7684\u4e66\u4e0e\u8bfb\u540e\u7684\u601d\u8003\u3002</p>"},{"location":"book/#_2","title":"\u5206\u7c7b","text":"<ul> <li>\ud83c\udfdb\ufe0f \u793e\u4f1a\u5b66\uff1a\u793e\u4f1a\u5b66\u3001\u793e\u4f1a\u89c2\u5bdf\u7c7b\u4e66\u7c4d\u6458\u6284\u4e0e\u611f\u609f</li> <li>\ud83d\udcdc \u5386\u53f2\uff1a\u4e16\u754c\u53f2\u3001\u8fd1\u73b0\u4ee3\u53f2\u76f8\u5173\u8bfb\u7269\u8bfb\u4e66\u7b14\u8bb0</li> <li>\ud83d\udcd6 \u6587\u5b66\uff1a\u5c0f\u8bf4\u3001\u6563\u6587\u3001\u8bd7\u6b4c\u6587\u5b66\u7c7b\u8bfb\u4e66\u8bb0\u5f55</li> <li>\ud83e\udde0 \u54f2\u5b66\u601d\u60f3\uff1a\u54f2\u5b66\u3001\u601d\u8fa8\u7c7b\u4e66\u7c4d\u8bfb\u540e\u611f</li> <li>\ud83d\udd2c \u79d1\u666e\u79d1\u5b66\uff1a\u81ea\u7136\u79d1\u5b66\u3001\u601d\u7ef4\u79d1\u666e\u7c7b\u8bfb\u4e66\u7b14\u8bb0</li> </ul>"},{"location":"book/#_3","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u672c\u4e66\u7684\u8bfb\u4e66\u7b14\u8bb0\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul>"},{"location":"book/history/","title":"\u5386\u53f2","text":"<p>\u4ee5\u53f2\u4e3a\u955c\uff0c\u53ef\u4ee5\u77e5\u5174\u66ff\u3002</p> <p>\u4e16\u754c\u53f2\u3001\u8fd1\u73b0\u4ee3\u53f2\u76f8\u5173\u8bfb\u7269\u8bfb\u4e66\u7b14\u8bb0\u3002</p>"},{"location":"book/history/#_2","title":"\u5728\u8bfb","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85</li> </ul>"},{"location":"book/history/#_3","title":"\u6587\u7ae0","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u7bc7\u5386\u53f2\u8bfb\u4e66\u7b14\u8bb0\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul> <p>\u5c0f\u63d0\u793a</p> <p>\u8bfb\u4e66\u7b14\u8bb0\u4f1a\u9646\u7eed\u8865\u5145\uff0c\u53ef\u4ee5\u5728\u9876\u90e8\u641c\u7d22\u6846\u641c\u7d22\u5173\u952e\u8bcd\uff0c\u5feb\u901f\u627e\u5230\u60f3\u770b\u7684\u5185\u5bb9\u3002</p>"},{"location":"book/literature/","title":"\u6587\u5b66","text":"<p>\u6587\u5b66\u662f\u751f\u6d3b\u88ab\u6587\u5b57\u7167\u4eae\u7684\u6837\u5b50\u3002</p> <p>\u5c0f\u8bf4\u3001\u6563\u6587\u3001\u8bd7\u6b4c\u6587\u5b66\u7c7b\u8bfb\u4e66\u8bb0\u5f55\u3002</p>"},{"location":"book/literature/#_2","title":"\u5728\u8bfb","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85</li> </ul>"},{"location":"book/literature/#_3","title":"\u6587\u7ae0","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u7bc7\u6587\u5b66\u8bfb\u4e66\u7b14\u8bb0\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul> <p>\u5c0f\u63d0\u793a</p> <p>\u8bfb\u4e66\u7b14\u8bb0\u4f1a\u9646\u7eed\u8865\u5145\uff0c\u53ef\u4ee5\u5728\u9876\u90e8\u641c\u7d22\u6846\u641c\u7d22\u5173\u952e\u8bcd\uff0c\u5feb\u901f\u627e\u5230\u60f3\u770b\u7684\u5185\u5bb9\u3002</p>"},{"location":"book/philosophy/","title":"\u54f2\u5b66\u601d\u60f3","text":"<p>\u672a\u7ecf\u5ba1\u89c6\u7684\u4eba\u751f\u4e0d\u503c\u5f97\u8fc7\u3002</p> <p>\u54f2\u5b66\u3001\u601d\u8fa8\u7c7b\u4e66\u7c4d\u8bfb\u540e\u611f\u3002</p>"},{"location":"book/philosophy/#_2","title":"\u5728\u8bfb","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85</li> </ul>"},{"location":"book/philosophy/#_3","title":"\u6587\u7ae0","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u7bc7\u54f2\u5b66\u8bfb\u4e66\u7b14\u8bb0\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul> <p>\u5c0f\u63d0\u793a</p> <p>\u8bfb\u4e66\u7b14\u8bb0\u4f1a\u9646\u7eed\u8865\u5145\uff0c\u53ef\u4ee5\u5728\u9876\u90e8\u641c\u7d22\u6846\u641c\u7d22\u5173\u952e\u8bcd\uff0c\u5feb\u901f\u627e\u5230\u60f3\u770b\u7684\u5185\u5bb9\u3002</p>"},{"location":"book/science/","title":"\u79d1\u666e\u79d1\u5b66","text":"<p>\u597d\u5947\u5fc3\u662f\u79d1\u5b66\u6700\u597d\u7684\u5f15\u8def\u4eba\u3002</p> <p>\u81ea\u7136\u79d1\u5b66\u3001\u601d\u7ef4\u79d1\u666e\u7c7b\u8bfb\u4e66\u7b14\u8bb0\u3002</p>"},{"location":"book/science/#_2","title":"\u5728\u8bfb","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85</li> </ul>"},{"location":"book/science/#_3","title":"\u6587\u7ae0","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u7bc7\u79d1\u666e\u8bfb\u4e66\u7b14\u8bb0\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul> <p>\u5c0f\u63d0\u793a</p> <p>\u8bfb\u4e66\u7b14\u8bb0\u4f1a\u9646\u7eed\u8865\u5145\uff0c\u53ef\u4ee5\u5728\u9876\u90e8\u641c\u7d22\u6846\u641c\u7d22\u5173\u952e\u8bcd\uff0c\u5feb\u901f\u627e\u5230\u60f3\u770b\u7684\u5185\u5bb9\u3002</p>"},{"location":"book/sociology/","title":"\u793e\u4f1a\u5b66","text":"<p>\u4eba\u662f\u793e\u4f1a\u7684\u52a8\u7269\u3002</p> <p>\u793e\u4f1a\u5b66\u3001\u793e\u4f1a\u89c2\u5bdf\u7c7b\u4e66\u7c4d\u6458\u6284\u4e0e\u611f\u609f\u3002</p>"},{"location":"book/sociology/#_2","title":"\u5728\u8bfb","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85</li> </ul>"},{"location":"book/sociology/#_3","title":"\u6587\u7ae0","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u7bc7\u793e\u4f1a\u5b66\u8bfb\u4e66\u7b14\u8bb0\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul> <p>\u5c0f\u63d0\u793a</p> <p>\u8bfb\u4e66\u7b14\u8bb0\u4f1a\u9646\u7eed\u8865\u5145\uff0c\u53ef\u4ee5\u5728\u9876\u90e8\u641c\u7d22\u6846\u641c\u7d22\u5173\u952e\u8bcd\uff0c\u5feb\u901f\u627e\u5230\u60f3\u770b\u7684\u5185\u5bb9\u3002</p>"},{"location":"life/","title":"\u751f\u6d3b","text":"<p>\u751f\u6d3b\u660e\u6717\uff0c\u4e07\u7269\u53ef\u7231\u3002</p> <p>\u751f\u6d3b\u968f\u7b14\u3001\u51fa\u884c\u65c5\u884c\u8bb0\u5f55\u3002</p>"},{"location":"life/#_2","title":"\u5206\u7c7b","text":"<ul> <li>\u2708\ufe0f \u65c5\u884c\u6e38\u8bb0\uff1a\u51fa\u884c\u3001\u6e38\u73a9\u89c1\u95fb\u8bb0\u5f55</li> <li>\u270d\ufe0f \u65e5\u5e38\u968f\u7b14\uff1a\u751f\u6d3b\u968f\u611f\u788e\u8bb0</li> </ul>"},{"location":"life/#_3","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u7bc7\u751f\u6d3b\u8bb0\u5f55\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul>"},{"location":"life/daily/","title":"\u65e5\u5e38\u968f\u7b14","text":"<p>\u751f\u6d3b\u7684\u610f\u4e49\uff0c\u85cf\u5728\u65e5\u5e38\u7684\u8936\u76b1\u91cc\u3002</p> <p>\u751f\u6d3b\u968f\u611f\u788e\u8bb0\u3002</p>"},{"location":"life/daily/#_2","title":"\u6587\u7ae0","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u7bc7\u65e5\u5e38\u968f\u7b14\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul> <p>\u5c0f\u63d0\u793a</p> <p>\u968f\u7b14\u4f1a\u9646\u7eed\u8865\u5145\uff0c\u53ef\u4ee5\u5728\u9876\u90e8\u641c\u7d22\u6846\u641c\u7d22\u5173\u952e\u8bcd\uff0c\u5feb\u901f\u627e\u5230\u60f3\u770b\u7684\u5185\u5bb9\u3002</p>"},{"location":"life/travel/","title":"\u65c5\u884c\u6e38\u8bb0","text":"<p>\u4e16\u754c\u90a3\u4e48\u5927\uff0c\u6162\u6162\u8d70\uff0c\u6162\u6162\u770b\u3002</p> <p>\u51fa\u884c\u3001\u6e38\u73a9\u89c1\u95fb\u8bb0\u5f55\u3002</p>"},{"location":"life/travel/#_2","title":"\u8db3\u8ff9\u5730\u56fe","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85</li> </ul>"},{"location":"life/travel/#_3","title":"\u6587\u7ae0","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u7bc7\u65c5\u884c\u6e38\u8bb0\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul> <p>\u5c0f\u63d0\u793a</p> <p>\u6e38\u8bb0\u4f1a\u9646\u7eed\u8865\u5145\uff0c\u53ef\u4ee5\u5728\u9876\u90e8\u641c\u7d22\u6846\u641c\u7d22\u5173\u952e\u8bcd\uff0c\u5feb\u901f\u627e\u5230\u60f3\u770b\u7684\u5185\u5bb9\u3002</p>"},{"location":"note/","title":"\u7b14\u8bb0","text":"<p>\u5b66\u800c\u65f6\u4e60\u4e4b\uff0c\u4e0d\u4ea6\u8bf4\u4e4e\u3002</p> <p>\u8fd9\u91cc\u662f\u5b66\u4e60\u7b14\u8bb0\u7684\u603b\u6c47\uff0c\u6536\u5f55\u6211\u5728\u4e13\u4e1a\u4e0e\u5174\u8da3\u9886\u57df\u91cc\u7684\u5b66\u4e60\u8bb0\u5f55\uff1a</p>"},{"location":"note/#_2","title":"\u5206\u7c7b","text":"<ul> <li>\ud83d\udcd7 \u4f1a\u8ba1\u7b14\u8bb0\uff1a\u8d22\u4f1a\u3001\u667a\u80fd\u8d22\u52a1\u76f8\u5173\u5b66\u4e60\u7b14\u8bb0</li> <li>\ud83d\udcbb \u8ba1\u7b97\u673a\u7b14\u8bb0\uff1a\u7f16\u7a0b\u3001\u5de5\u5177\u3001\u8ba1\u7b97\u673a\u7406\u8bba\u5b66\u4e60\u7b14\u8bb0</li> <li>\ud83d\udcc8 \u7ecf\u6d4e\u5b66\u7b14\u8bb0\uff1a\u5fae\u89c2\u5b8f\u89c2\u7ecf\u6d4e\u5b66\u3001\u7ecf\u6d4e\u7406\u8bba\u7b14\u8bb0</li> <li>\ud83d\udc26 \u89c2\u9e1f\u7b14\u8bb0\uff1a\u9e1f\u7c7b\u79d1\u666e\u3001\u91ce\u5916\u89c2\u5bdf\u8bb0\u5f55</li> </ul>"},{"location":"note/#_3","title":"\u6587\u7ae0\u5217\u8868","text":""},{"location":"note/#_4","title":"\u4f1a\u8ba1","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u4f1a\u8ba1\u57fa\u7840\u6982\u5ff5\u5165\u95e8</li> </ul>"},{"location":"note/#_5","title":"\u8ba1\u7b97\u673a","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7f16\u7a0b\u4e0e\u5de5\u5177\u4f7f\u7528\u5fc3\u5f97</li> </ul>"},{"location":"note/#_6","title":"\u7ecf\u6d4e\u5b66","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7ecf\u6d4e\u5b66\u7406\u8bba\u5b66\u4e60\u8bb0\u5f55</li> </ul>"},{"location":"note/#_7","title":"\u89c2\u9e1f","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u6b21\u91ce\u5916\u89c2\u5bdf\u8bb0\u5f55</li> </ul>"},{"location":"note/accounting/","title":"\u4f1a\u8ba1\u7b14\u8bb0","text":"<p>\u6570\u5b57\u80cc\u540e\uff0c\u662f\u4e16\u754c\u7684\u8fd0\u8f6c\u903b\u8f91\u3002</p> <p>\u8fd9\u91cc\u5b58\u653e\u8d22\u4f1a\u3001\u667a\u80fd\u8d22\u52a1\u76f8\u5173\u7684\u5b66\u4e60\u7b14\u8bb0\u3002</p>"},{"location":"note/accounting/#_2","title":"\u5b66\u4e60\u8def\u7ebf","text":"<ul> <li>\u4f1a\u8ba1\u57fa\u7840\u6982\u5ff5</li> <li>\u8d22\u52a1\u62a5\u8868\u9605\u8bfb\uff08\u8d44\u4ea7\u8d1f\u503a\u8868\u3001\u5229\u6da6\u8868\u3001\u73b0\u91d1\u6d41\u91cf\u8868\uff09</li> <li>\u667a\u80fd\u8d22\u52a1\u4e0e\u8d22\u52a1\u6570\u5b57\u5316\u5de5\u5177</li> <li>\u5ba1\u8ba1\u57fa\u7840</li> </ul>"},{"location":"note/accounting/#_3","title":"\u6587\u7ae0","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u7bc7\u4f1a\u8ba1\u7b14\u8bb0\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul> <p>\u5c0f\u63d0\u793a</p> <p>\u5b66\u4e60\u7b14\u8bb0\u4f1a\u9646\u7eed\u8865\u5145\uff0c\u53ef\u4ee5\u5728\u9876\u90e8\u641c\u7d22\u6846\u641c\u7d22\u5173\u952e\u8bcd\uff0c\u5feb\u901f\u627e\u5230\u60f3\u770b\u7684\u5185\u5bb9\u3002</p>"},{"location":"note/bird/","title":"\u89c2\u9e1f\u7b14\u8bb0","text":"<p>\u5929\u7a7a\u6ca1\u6709\u7559\u4e0b\u7fc5\u8180\u7684\u75d5\u8ff9\uff0c\u4f46\u6211\u5df2\u770b\u8fc7\u98de\u8fc7\u3002</p> <p>\u8fd9\u91cc\u5b58\u653e\u9e1f\u7c7b\u79d1\u666e\u3001\u91ce\u5916\u89c2\u5bdf\u8bb0\u5f55\u3002</p>"},{"location":"note/bird/#_2","title":"\u76ee\u5f55","text":"<ul> <li>\u9e1f\u7c7b\u56fe\u9274\u4e0e\u8bc6\u522b\u6280\u5de7</li> <li>\u91ce\u5916\u89c2\u5bdf\u8bb0\u5f55\uff08\u65f6\u95f4\u3001\u5730\u70b9\u3001\u9e1f\u79cd\uff09</li> <li>\u5e38\u89c1\u9e1f\u79cd\u79d1\u666e</li> <li>\u89c2\u9e1f\u88c5\u5907\u4e0e\u5165\u95e8\u6307\u5357</li> </ul>"},{"location":"note/bird/#_3","title":"\u6587\u7ae0","text":"<ul> <li>\u656c\u8bf7\u671f\u5f85\uff1a\u7b2c\u4e00\u6b21\u91ce\u5916\u89c2\u5bdf\u8bb0\u5f55\u6b63\u5728\u8def\u4e0a\uff5e</li> </ul> <p>\u5c0f\u63d0\u793a</p> <p>\u5b66\u4e60\u7b14\u8bb0\u4f1a\u9646\u7eed\u8865\u5145\uff0c\u53ef\u4ee5\u5728\u9876\u90e8\u641c\u7d22\u6846\u641c\u7d22\u5173\u952e\u8bcd\uff0c\u5feb\u901f\u627e\u5230\u60f3\u770b\u7684\u5185\u5bb9\u3002</p>"},{"location":"note/computer/","title":"\u8ba1\u7b97\u673a\u7b14\u8bb0","text":"<p>\u8ba1\u7b97\u673a\u662f\u601d\u7ef4\u7684\u653e\u5927\u5668\u3002</p> <p>\u8fd9\u91cc\u5b58\u653e\u7f16\u7a0b\u3001\u5de5\u5177\u3001\u8ba1\u7b97\u673a\u7406\u8bba\u7684\u5b66\u4e60\u7b14\u8bb0\u3002</p>"},{"location":"note/computer/#_2","title":"\u76ee\u5f55","text":"<ul> <li>\u7f16\u7a0b\u8bed\u8a00\uff08Python / JavaScript \u7b49\uff09</li> <li>\u5f00\u53d1\u5de5\u5177\uff08Git\u3001\u547d\u4ee4\u884c\u3001\u7f16